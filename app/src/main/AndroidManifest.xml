<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlossomAssistant"
        tools:targetApi="31">

        <!-- Main Launcher -->
        <activity
            android:name=".LoginChoiceActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADD ALL OTHER ACTIVITIES BELOW -->

        <activity android:name=".CategoryActivity" />
        <activity android:name=".DesignActivity" />
        <activity android:name=".CustomizeActivity" />
        <activity android:name=".OrderActivity" />
        <activity android:name=".ConfirmationActivity" />
        <activity android:name=".CartActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".UserLoginActivity" />

        <!-- Admin activities -->
        <activity android:name=".AdminLoginActivity" />
        <activity android:name=".AdminDashboardActivity" />
        <activity android:name=".AdminDesignActivity" />
        <activity android:name=".AdminOrderActivity" />

    </application>

</manifest>